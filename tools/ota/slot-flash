#!/bin/bash
# Write a root slot image to a slot and make that slot bootable.

set -euo pipefail

BOOT_DIR=/boot/firmware
CONFIG="${BOOT_DIR}/config.txt"

SLOT_A_PART=2
SLOT_B_PART=3

die() {
  echo "${0##*/}: $*" >&2
  exit 1
}

warn() {
  echo "${0##*/}: $*" >&2
}

info() {
  echo "${0##*/}: $*"
}

usage() {
  cat >&2 << EOF
usage: ${0##*/} --slot a|b <url|file>

  --slot a|b   the slot to write; must not be the running one
  <url|file>   the .rootfs.img[.xz|.gz|.zst]
EOF
  exit "${1:-2}"
}

SLOT=""
SOURCE=""

while [ $# -gt 0 ]; do
  case "$1" in
    --slot)
      [ $# -ge 2 ] || usage
      SLOT="$2"
      shift 2
      ;;
    -h | --help) usage 0 ;;
    -*) die "unknown option: $1" ;;
    *)
      [ -z "${SOURCE}" ] || die "only one image at a time"
      SOURCE="$1"
      shift
      ;;
  esac
done

[ -n "${SLOT}" ] && [ -n "${SOURCE}" ] || usage

case "${SLOT}" in
  a | A) TARGET_PART="${SLOT_A_PART}" ;;
  b | B) TARGET_PART="${SLOT_B_PART}" ;;
  *) die "not a slot: ${SLOT} (expected a or b)" ;;
esac

SLOT="$(printf '%s' "${SLOT}" | tr '[:upper:]' '[:lower:]')"
TARGET_PREFIX="slot-${SLOT}"

[ "$(id -u)" = 0 ] || die "must run as root"

for CMD in bmaptool findmnt dd xxd tune2fs blockdev du df; do
  command -v "${CMD}" > /dev/null 2>&1 || die "missing required command: ${CMD}"
done

is_url() {
  case "$1" in
    http://* | https://* | ftp://*) return 0 ;;
    *) return 1 ;;
  esac
}

is_url "${SOURCE}" && { command -v curl > /dev/null 2>&1 || die "missing curl"; }

#
# Where we are
#

# the value of a key=value kernel parameter; splitting on whitespace is the parse
cmdline_param() {
  local key="$1" file="$2" param
  # shellcheck disable=SC2013
  for param in $(cat "${file}"); do
    if [ "${param#"${key}"=}" != "${param}" ]; then
      printf '%s' "${param#*=}"
      return 0
    fi
  done
  return 1
}

ROOT_PARAM="$(cmdline_param root /proc/cmdline)" || die "no root= on /proc/cmdline"
PARTUUID="${ROOT_PARAM#PARTUUID=}"
# the partition number is the last field: an MBR PARTUUID is <disk id>-<nn>
RUNNING_PART="$((10#${PARTUUID##*-}))"

# / is an overlay, so resolve the disk through the PARTUUID instead of findmnt
LINK="/dev/disk/by-partuuid/${PARTUUID}"
[ -e "${LINK}" ] || die "${LINK} does not exist"
PART_DEV="$(readlink -f "${LINK}")"
SYSFS="/sys/class/block/${PART_DEV##*/}"
[ -r "${SYSFS}/partition" ] || die "${PART_DEV} is not a partition"
DISK="/dev/$(basename "$(readlink -f "${SYSFS}/..")")"

case "${DISK}" in
  *[0-9]) TARGET_DEV="${DISK}p${TARGET_PART}" ;;
  *) TARGET_DEV="${DISK}${TARGET_PART}" ;;
esac

DISK_ID="$(dd if="${DISK}" skip=440 bs=1 count=4 2> /dev/null | xxd -e | cut -f 2 -d' ')"

# the live cmdline.txt sits under os_prefix, next to the active slot's kernel
active_prefix() {
  local prefix=""
  if [ -r "${CONFIG}" ]; then
    prefix="$(sed -nE 's/^[[:space:]]*os_prefix=([^[:space:]]*).*/\1/p' "${CONFIG}" |
      tr -d '\r' | head -n1)"
  fi
  printf '%s' "${prefix}"
}

ACTIVE_PREFIX="$(active_prefix)"

case "${RUNNING_PART}" in
  "${SLOT_A_PART}") RUNNING_SLOT=a ;;
  "${SLOT_B_PART}") RUNNING_SLOT=b ;;
  *) die "the running root is p${RUNNING_PART}, neither slot a nor slot b" ;;
esac

info "card      ${DISK} (disk id ${DISK_ID})"
info "running   slot ${RUNNING_SLOT} (p${RUNNING_PART})"
info "target    ${TARGET_PREFIX} on ${TARGET_DEV}"

#
# Guards
#

[ "${TARGET_PART}" != "${RUNNING_PART}" ] ||
  die "slot ${SLOT} is the running slot: refusing to overwrite it"

[ -b "${TARGET_DEV}" ] || die "${TARGET_DEV} is not a block device"

if findmnt -S "${TARGET_DEV}" > /dev/null 2>&1; then
  die "${TARGET_DEV} is mounted: refusing to write under a live filesystem"
fi

if [ "${ACTIVE_PREFIX}" = "${TARGET_PREFIX}/" ]; then
  warn "config.txt already boots ${TARGET_PREFIX}, which is about to be rebuilt"
fi

if ! is_url "${SOURCE}"; then
  [ -r "${SOURCE}" ] || die "cannot read ${SOURCE}"
  SRC_FS="$(findmnt -no FSTYPE -T "${SOURCE}")"
  case "${SRC_FS}" in
    tmpfs | overlay)
      die "${SOURCE} is on ${SRC_FS} (RAM): put it on /data or pass a URL"
      ;;
  esac
fi

#
# Write
#

WORK="$(mktemp -d /run/slot-flash.XXXXXX)"
MNT="${WORK}/slot"
BOOT_REMOUNTED=no
STAGING=""

cleanup() {
  [ -z "${STAGING}" ] || rm -rf "${STAGING}" || :
  findmnt -M "${MNT}" > /dev/null 2>&1 && umount "${MNT}" || :
  if [ "${BOOT_REMOUNTED}" = yes ]; then
    sync
    mount -o remount,ro "${BOOT_DIR}" || warn "cannot restore ${BOOT_DIR} read-only"
  fi
  rm -rf "${WORK}" || :
}
trap cleanup EXIT

boot_rw() {
  if findmnt -no OPTIONS "${BOOT_DIR}" | grep -qE '(^|,)ro(,|$)'; then
    mount -o remount,rw "${BOOT_DIR}" || die "cannot remount ${BOOT_DIR} read-write"
    BOOT_REMOUNTED=yes
  fi
}

# the build ships <name>.rootfs.bmap next to <name>.rootfs.img[.xz|.gz|.zst]
bmap_sibling() {
  local base="$1"
  base="${base%.xz}"
  base="${base%.gz}"
  base="${base%.zst}"
  printf '%s.bmap' "${base%.img}"
}

BMAP_SRC="$(bmap_sibling "${SOURCE}")"
BMAP="${WORK}/bmap"
BMAP_OPT=(--nobmap)

if is_url "${BMAP_SRC}"; then
  curl -fsSL -o "${BMAP}" "${BMAP_SRC}" 2> /dev/null && BMAP_OPT=(--bmap "${BMAP}")
elif [ -r "${BMAP_SRC}" ]; then
  cp "${BMAP_SRC}" "${BMAP}" && BMAP_OPT=(--bmap "${BMAP}")
fi

if [ "${BMAP_OPT[0]}" = --nobmap ]; then
  warn "no bmap at ${BMAP_SRC}: writing every block, with no checksum verification"
else
  info "bmap found: sparse write, every range checksummed as it goes"
fi

info "writing the rootfs to ${TARGET_DEV}"
bmaptool copy "${BMAP_OPT[@]}" "${SOURCE}" "${TARGET_DEV}"

sync
blockdev --flushbufs "${TARGET_DEV}" || :

# both slots come off the same image, so without this they share a filesystem UUID
tune2fs -U random "${TARGET_DEV}" > /dev/null
info "filesystem UUID re-randomised"

#
# Build the slot's boot payload out of the slot itself
#

mkdir -p "${MNT}"
mount -t ext4 -o ro "${TARGET_DEV}" "${MNT}" || die "cannot mount ${TARGET_DEV}"

MODULES="${MNT}/usr/lib/modules"
[ -d "${MODULES}" ] || die "${TARGET_DEV} has no /usr/lib/modules: is this a slot image?"

shopt -s nullglob
KERNELS=("${MNT}"/boot/vmlinuz-*)
shopt -u nullglob
[ "${#KERNELS[@]}" -gt 0 ] || die "${TARGET_DEV} has no /boot/vmlinuz-*"

# the payload is staged beside the live one, so both have to fit at once
SIZE_PATHS=()
for KERNEL in "${KERNELS[@]}"; do
  VERSION="${KERNEL##*/vmlinuz-}"
  SIZE_PATHS+=("${KERNEL}")
  if [ -f "${MNT}/boot/initrd.img-${VERSION}" ]; then
    SIZE_PATHS+=("${MNT}/boot/initrd.img-${VERSION}")
  fi
  if [ -d "${MODULES}/${VERSION}/dtb" ]; then
    SIZE_PATHS+=("${MODULES}/${VERSION}/dtb")
  fi
done

NEEDED="$(du -scb "${SIZE_PATHS[@]}" | tail -n1 | cut -f1)"
AVAILABLE="$(df -B1 --output=avail "${BOOT_DIR}" | tail -n1)"

if [ "${NEEDED}" -gt "${AVAILABLE}" ]; then
  die "need $((NEEDED / 1024 / 1024)) MiB on ${BOOT_DIR} but only $((AVAILABLE / 1024 / 1024)) MiB are free"
fi

boot_rw

STAGING="${BOOT_DIR}/${TARGET_PREFIX}.new"
rm -rf "${STAGING}"
mkdir -p "${STAGING}/overlays"

# the names and the layout are the raspi-firmware hook's, so the firmware finds
# exactly what it would have found had the build written it here
for KERNEL in "${KERNELS[@]}"; do
  VERSION="${KERNEL##*/vmlinuz-}"
  FLAVOUR="${VERSION#*-rpi-}"
  SUFFIX="$(printf '%s' "${FLAVOUR}" | sed 's/^v//;s/^6//;s/2712/_2712/;s/-/_/;')"

  case "${FLAVOUR}" in
    v8 | v8-rt | 2712) DTB_DIR="${MODULES}/${VERSION}/dtb/broadcom" ;;
    v6 | v7) DTB_DIR="${MODULES}/${VERSION}/dtb" ;;
    *)
      warn "unsupported kernel flavour ${FLAVOUR}, skipping ${VERSION}"
      continue
      ;;
  esac

  cp "${KERNEL}" "${STAGING}/kernel${SUFFIX}.img"

  INITRD="${MNT}/boot/initrd.img-${VERSION}"
  if [ -f "${INITRD}" ]; then
    cp "${INITRD}" "${STAGING}/initramfs${SUFFIX}"
  else
    warn "no initrd.img-${VERSION}: ${VERSION} will boot without an initramfs"
  fi

  shopt -s nullglob
  for DTB in "${DTB_DIR}"/bcm*.dtb; do
    cp "${DTB}" "${STAGING}/"
  done
  for OVERLAY in "${MODULES}/${VERSION}"/dtb/overlays/*.dtb* \
    "${MODULES}/${VERSION}"/dtb/overlays/README; do
    # README carries no wildcard, so nullglob cannot drop it
    [ -e "${OVERLAY}" ] || continue
    cp "${OVERLAY}" "${STAGING}/overlays/"
  done
  shopt -u nullglob

  info "payload: ${VERSION} -> kernel${SUFFIX}.img"
done

# The command line comes from the image we just wrote, in step with its kernel;
# the one on the boot partition has whatever drift the card accumulated.
TEMPLATE="${MNT}/usr/lib/bootdata/cmdline.txt"
[ -f "${TEMPLATE}" ] || die "${TEMPLATE} is missing: not a slot image of this build"

NEW_CMDLINE=""
HAS_ROOT=no
HAS_SLOT=no
for PARAM in $(tr -d '\r' < "${TEMPLATE}"); do
  case "${PARAM}" in
    root=ROOTDEV)
      PARAM="root=PARTUUID=${DISK_ID}-0${TARGET_PART}"
      HAS_ROOT=yes
      ;;
    rauc.slot=SLOTNAME)
      PARAM="rauc.slot=${TARGET_PREFIX}"
      HAS_SLOT=yes
      ;;
  esac
  NEW_CMDLINE="${NEW_CMDLINE:+${NEW_CMDLINE} }${PARAM}"
done

# an unsubstituted placeholder is better than a slot pointing at the other one
[ "${HAS_ROOT}" = yes ] || die "no root=ROOTDEV in ${TEMPLATE}"
[ "${HAS_SLOT}" = yes ] || die "no rauc.slot=SLOTNAME in ${TEMPLATE}"

printf '%s\n' "${NEW_CMDLINE}" > "${STAGING}/cmdline.txt"

umount "${MNT}"

# two renames, so the directory is never partly present under its real name
TARGET_FINAL="${BOOT_DIR}/${TARGET_PREFIX}"
if [ -e "${TARGET_FINAL}" ]; then
  rm -rf "${TARGET_FINAL}.old"
  mv "${TARGET_FINAL}" "${TARGET_FINAL}.old"
fi
mv "${STAGING}" "${TARGET_FINAL}"
STAGING=""
rm -rf "${TARGET_FINAL}.old"
sync

info "slot ${SLOT} written and ${TARGET_PREFIX}/ installed on the boot partition"
info "run 'slot-switch ${SLOT}' and reboot to use it"
